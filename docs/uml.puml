@startuml ibkr_conn_architecture
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowFontSize 11
skinparam packageBorderThickness 1

title **ibkr_conn — OOP Architecture (refactored)**
8 Python modules · 3 zones · Typed DTOs · Singleton SessionManager · IBGateway class

' ══════════════════════════════════════════════════════════════════════
' Zone: CLI Entry
' ══════════════════════════════════════════════════════════════════════
package "CLI Entry" #LightCyan {
    component "run_service.py\n--\nmain() — dispatch by --mode\nbuild_ibkr_parser()\n_clean_stale_pycache()\n_handle_status()" as run_service #LightCyan
}

' ══════════════════════════════════════════════════════════════════════
' Zone: Application Logic
' ══════════════════════════════════════════════════════════════════════
package "Application Logic" #LightBlue {

    component "session_manager.py\n--\nSessionManager (Singleton)\ncomposes IBGateway (self._gateway)\ncomposes QuestDBManager (self._questdb)\n\nget_ib_conn() — 6×5s retry\n  → IBConnectionFatalError\nget_questdb() → QuestDBManager\non_error() — clear _ib + signal\nstart() → start_questdb()\n         + gateway.start_gateway()\n         + gateway.wait_for_api(self)\nstop() → gateway.stop_gateway()\n         + stop_questdb()\nsession_status() — health + keepalive\nget_status() → session_status()\n_ensure_gateway_ready() → gateway.ensure_gateway()\nkeep_alive() · set_keepalive()\nacquire_pid_lock() · release_pid_lock()\n_on_gateway_terminated() — callback\n\nException:\n  IBConnectionFatalError" as session_mgr #LightBlue

    component "data_downloader.py\n--\nDataDownloader (Dependency Injection)\nconstructor: __init__(mgr: SessionManager)\n\ndownload_bars() — error recovery loop\nstart_streaming() — PID-locked entry\nstream_data() — keepalive-aware main loop\n_do_bars_download() — core bar pull\n_load_tick_config() — JSON load\n\nModule-level helpers:\n  _generate_chunks() — date range splitting\n  _fetch_chunk() — single hist request\n  _download_bars() — multi-chunk fetch + dedup\n  _to_hist_bar() — BarData → HistBarData\n  _bars_to_csv() — CSV export\n  _build_ilp_line() — ticker → ILP line\n  stream_live_ticks() — direct stream function" as data_dl #LightGray

    component "utils.py\n--\nShared utilities (no connections)\n\nbuild_ric_contract()\nresolve_contracts() — multi-contract\n  from tick config dicts\nget_contract() — single from CLI args\nparse_date_range()\n_month_map()\n\nConstants:\n  OUTPUT_DIR, BAR_SIZE, etc." as utils #LightGray

    component "ibgateway.py\n--\nIBGateway class (encapsulated):\n  __init__(on_gateway_terminated=[]) — callbacks\n  get_credentials() — static\n  generate_config_ini(paper) — instance\n  start_gateway() — daemon thread\n  wait_for_api(mgr, timeout) — poll\n  stop_gateway() — socket nc + Java kill\n  ensure_gateway(mgr, timeout) —\n    probe + auto-restart\n  _send_stop_via_nc() — private\n  _kill_java_processes() — private\n  _probe_gateway_api() — private\n\nModule-level:\n  install_scripts()" as ibgateway #LightBlue

    component "questdb.py\n--\nQuestDBManager — ILP writer\n  send_ilp_batch() → /write\n  write_bars() → futures_hist\n  write_ticks() → futures_tick\n  is_port_open() — static\n  is_questdb_running() — static\n  find_questdb_pid() — static\n\nModule-level:\n  start_questdb()\n  stop_questdb()" as questdb #LightBlue

    component "🔐 IB() Guard Rule\n--\nOnly session_manager.py may\nconstruct ib_insync.IB()\nor call ib.connect().\n\ngrep -rn IB() --include='*.py'" as ib_guard #LightPink
}

' ══════════════════════════════════════════════════════════════════════
' Zone: External Dependencies
' ══════════════════════════════════════════════════════════════════════
package "External Dependencies" #LightYellow {
    component "IB Gateway (TWS)\n--\nTCP :4002\nPaper/live trading\n\nib_insync library\nIBC controller" as ib_gateway_ext #LightYellow

    database "QuestDB Server\n--\nHTTP :9000 / ILP :9009\n\nfutures_hist table\nfutures_tick table\nQuestDB-Runtime JVM" as questdb_ext #LightGreen

    database "CSV File System\n--\nOutput directory\n\nbars CSV export\n(--format csv)" as csv_ext #LightGreen
}

' ══════════════════════════════════════════════════════════════════════
' Supporting modules (right panel)
' ══════════════════════════════════════════════════════════════════════
package "Supporting Types" #Lavender {
    component "data_record.py\n--\nTyped NamedTuple DTOs\n\nHistBarData\ndate, open, high, low, close\nvolume, bar_count, average\n\nFutureTickData\ntime, bid, ask, last\nbid_size, ask_size, last_size" as data_record #Lavender

    component "logger.py\n--\nStructured logging\n\nconfigure_pipeline_logging()\n  → console (stdout) INFO\n  → rotating file DEBUG\n  (10MB × 3 backups)\n\nget_logger(name)\n\nIdempotent, one-time" as logger #LightGray
}

' ══════════════════════════════════════════════════════════════════════
' Runtime Resources
' ══════════════════════════════════════════════════════════════════════
package "Runtime Resources" #LightGreen {
    component "configs/\n--\ndownload_live_tick.json\n.ibkr_keepalive\n.ibkr_stream.pid\n.ibkr_gateway.pid" as configs_dir #LightGreen

    component "scripts/\n--\nIBC shell scripts:\ndisplaybannerandlaunch.sh\nibcstart.sh, commandsend.sh\nstop.sh, version" as scripts_dir #LightGreen

    component "logs/\n--\npipeline.log\npipeline.log.N (rotated)" as logs_dir #LightGreen

    component "tests/\n--\ntest_ibgateway_readiness.py\ntest_resolve_contracts.py" as tests_dir #LightGreen
}

' ══════════════════════════════════════════════════════════════════════
' Dependencies
' ══════════════════════════════════════════════════════════════════════
run_service --> session_mgr : creates & dispatches
run_service --> data_dl : DataDownloader(mgr) DI
run_service --> logger : configures
run_service --> data_record : imports DTOs

data_dl --> session_mgr : get_ib_conn() / get_questdb()
data_dl --> utils : get_contract() / resolve_contracts()
data_dl --> questdb : write_bars() / write_ticks()
data_dl --> data_record : HistBarData

session_mgr --> ibgateway : composes\n  start()→gateway.start_gateway()\n  stop()→gateway.stop_gateway()\n  ensure→gateway.ensure_gateway()
session_mgr --> questdb : composes (self._questdb)\n  start()→start_questdb()\n  stop()→stop_questdb()
session_mgr --> ib_gateway_ext : ib.connect() inside get_ib_conn()

ibgateway --> ib_gateway_ext : subprocess
ibgateway --> configs_dir : generates config.ini
ibgateway --> scripts_dir : runs displaybannerandlaunch.sh

questdb --> questdb_ext : ILP /write

data_dl --> configs_dir : reads download_live_tick.json

logger --> data_dl : logs
logger --> session_mgr : logs
logger --> ibgateway : logs
logger --> questdb : logs
logger --> utils : logs
logger --> logs_dir : rotates pipeline.log

ib_guard --> session_mgr : enforces
ib_guard --> data_dl : restricts

' ══════════════════════════════════════════════════════════════════════
' Legend
' ══════════════════════════════════════════════════════════════════════
legend bottom
  <#LightCyan>CLI Entry</#> | <#LightBlue>Application</#> | <#LightGray>Library</#>
  <#LightYellow>External</#> | <#LightGreen>Storage</#> | <#LightPink>Constraint</#>
  <#Lavender>DTOs</#>
  --> solid: Import/Call
endlegend

@enduml
