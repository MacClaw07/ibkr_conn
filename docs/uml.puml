@startuml ibkr_conn_architecture
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowFontSize 11
skinparam packageBorderThickness 1

title **ibkr_conn — OOP Architecture (July 2026)**
8 Python modules · 3 zones · Typed DTOs · Singleton SessionManager · IBGateway class

' ══════════════════════════════════════════════════════════════════════
' Zone: CLI Entry
' ══════════════════════════════════════════════════════════════════════
package "CLI Entry" #LightCyan {
    component "run_service.py\n--\nmain() — dispatch by --mode\nbuild_ibkr_parser()\n_clean_stale_pycache()\n_handle_status()" as run_service #LightCyan
}

' ══════════════════════════════════════════════════════════════════════
' Zone: Application Logic
' ══════════════════════════════════════════════════════════════════════
package "Application Logic" #LightBlue {

    component "session_manager.py\n--\nSessionManager (Singleton)\ncomposes IBGateway (self._gateway)\ncomposes QuestDBManager (self._questdb)\n\nget_ib_conn() — 6×5s retry\n  → IBConnectionFatalError\nget_questdb() → QuestDBManager\non_error() — clear _ib + signal\nstart() → start_questdb()\n         + gateway.start_gateway()\n         + gateway.wait_for_api(self)\nstop() → gateway.stop_gateway()\n         + stop_questdb()\nsession_status() — health + keepalive\nget_status() → session_status()\nkeep_alive() · set_keepalive()\nacquire_pid_lock() · release_pid_lock()\n_on_gateway_terminated() — callback\n_ensure_gateway_ready()\n\nException:\n  IBConnectionFatalError" as session_mgr #LightBlue

    component "data_downloader.py\n--\nDataDownloader (DI via mgr)\nconstructor: __init__(mgr)\n\ndownload_bars() — error recovery loop\n  → writes bars to QuestDB via ILP\n  → supports FOP (options) hist\nstart_streaming() — PID-locked entry\nstream_data() — keepalive loop\n\nModule-level helpers:\n  _generate_chunks() — date split\n  _fetch_chunk() — single hist req\n  _download_bars() — multi-chunk+ddup\n  _to_hist_bar() — BarData→HistBarData\n  _to_hist_option_bar() — BarData→HistBarOptionData\n  _build_ilp_line() — ticker→ILP\n  _stream_live_ticks() — main loop\n  _subscribe_contracts() — handlers\n  _flush_pending_lines() — batch flush\n  _log_stream_status() — 30s status" as data_dl #LightGray

    component "utils.py\n--\nShared utilities (no connections)\n\nbuild_ric_contract()\n  → Future / FuturesOption / Stock\nresolve_contracts() — multi-contract\n  from tick config dicts\nget_contract() — single from CLI\nparse_date_range()\n_month_map()\nresolve_option_underlying()\nload_tick_config() — JSON load\n\nConstants:\n  OUTPUT_DIR, BAR_SIZE, etc." as utils #LightGray

    component "ibgateway.py\n--\nIBGateway class (encapsulated):\n  __init__(on_gateway_terminated=[])\n  get_credentials() — static\n  generate_config_ini(paper) — instance\n  add_gateway_terminated_handler()\n  start_gateway() — daemon thread\n  wait_for_api(mgr, timeout) — poll\n  stop_gateway() — socket nc + Java kill\n  ensure_gateway(mgr, timeout) —\n    probe + auto-restart\n  _send_stop_via_nc()\n  _kill_java_processes()\n  _probe_gateway_api() — uses temp IB()\n    but never exports it\n\nModule-level:\n  get_credentials()\n  generate_config_ini()\n  install_scripts()" as ibgateway #LightBlue

    component "questdb.py\n--\nQuestDBManager — ILP writer\n  __init__(host, port=9000)\n  url → REST base URL\n  send_ilp_batch() → /write POST\n  write_bars() → futures_hist/options_hist\n    supports FUT + FOP sec types\n  write_ticks() → futures_tick\n  Static: is_port_open()\n  Static: is_questdb_running()\n  Static: find_questdb_pid()\n  Static: _ok(val) — NaN check\n  Static: _format_ilp_timestamp(dt)\n\nModule-level:\n  start_questdb()\n  stop_questdb()" as questdb #LightBlue

    component "🔐 IB() Guard Rule\n--\nOnly session_manager.py may\nconstruct ib_async.IB()\nor call ib.connect().\n\nibgateway._probe_gateway_api()\nuses temp IB() for probing\nbut never exports or stores it." as ib_guard #LightPink
}

' ══════════════════════════════════════════════════════════════════════
' Zone: External Dependencies
' ══════════════════════════════════════════════════════════════════════
package "External Dependencies" #LightYellow {
    component "IB Gateway (TWS)\n--\nTCP :4002\nPaper/live trading\n\nib_async library\nIBC controller" as ib_gateway_ext #LightYellow

    database "QuestDB Server\n--\nHTTP :9000\n\nfutures_hist table\noptions_hist table\nfutures_tick table\noptions_tick table\nQuestDB-Runtime JVM" as questdb_ext #LightGreen
}

' ══════════════════════════════════════════════════════════════════════
' Supporting modules (right panel)
' ══════════════════════════════════════════════════════════════════════
package "Supporting Types" #Lavender {
    component "data_record.py\n--\nTyped NamedTuple DTOs\n\nHistBarData\ndate, open, high, low, close\nvolume, bar_count, average\n\nHistBarOptionData\ndate, underlying_ric, type\nstrike, open, high, low, close\nvolume, bar_count, average\n\nFutureTickData\ntime, bid, ask, last\nbid_size, ask_size, last_size" as data_record #Lavender

    component "logger.py\n--\nStructured logging\n\nconfigure_pipeline_logging()\n  → console (stdout) INFO\n  → rotating file DEBUG\n  (10MB × 3 backups)\n\nget_logger(name)\n\nIdempotent, one-time" as logger #LightGray
}

' ══════════════════════════════════════════════════════════════════════
' Runtime Resources
' ══════════════════════════════════════════════════════════════════════
package "Runtime Resources" #LightGreen {
    component "configs/\n--\ndownload_live_tick.json\n.ibkr_keepalive\n.ibkr_stream.pid\n.ibkr_gateway.pid" as configs_dir #LightGreen

    component "scripts/\n--\nIBC shell scripts:\ndisplaybannerandlaunch.sh\nibcstart.sh, commandsend.sh\nstop.sh, version" as scripts_dir #LightGreen

    component "logs/\n--\npipeline.log\npipeline.log.N (rotated)" as logs_dir #LightGreen

    component "tests/\n--\ntest_data_downloader.py\ntest_ibgateway_readiness.py\ntest_resolve_contracts.py\ntest_session_manager_gateway.py" as tests_dir #LightGreen
}

' ══════════════════════════════════════════════════════════════════════
' Dependencies
' ══════════════════════════════════════════════════════════════════════
run_service --> session_mgr : creates & dispatches
run_service --> data_dl : DataDownloader(mgr) DI
run_service --> logger : configures
run_service --> data_record : imports DTOs

data_dl --> session_mgr : get_ib_conn() / get_questdb()
data_dl --> utils : get_contract() / resolve_contracts() / load_tick_config()
data_dl --> questdb : write_bars() / send_ilp_batch()
data_dl --> data_record : HistBarData / HistBarOptionData

session_mgr --> ibgateway : composes\n  start()→gateway.start_gateway()\n  stop()→gateway.stop_gateway()\n  ensure→gateway.ensure_gateway()
session_mgr --> questdb : composes (self._questdb)\n  start()→start_questdb()\n  stop()→stop_questdb()
session_mgr --> ib_gateway_ext : ib.connect() inside get_ib_conn()

ibgateway --> ib_gateway_ext : subprocess
ibgateway --> configs_dir : generates config.ini
ibgateway --> scripts_dir : runs displaybannerandlaunch.sh

questdb --> questdb_ext : ILP /write (futures_hist, options_hist, futures_tick, options_tick)

data_dl --> configs_dir : reads download_live_tick.json

logger --> data_dl : logs
logger --> session_mgr : logs
logger --> ibgateway : logs
logger --> questdb : logs
logger --> utils : logs
logger --> logs_dir : rotates pipeline.log

ib_guard --> session_mgr : enforces
ib_guard --> data_dl : restricts

' ══════════════════════════════════════════════════════════════════════
' Legend
' ══════════════════════════════════════════════════════════════════════
legend bottom
  <#LightCyan>CLI Entry</#> | <#LightBlue>Application</#> | <#LightGray>Library</#>
  <#LightYellow>External</#> | <#LightGreen>Storage</#> | <#LightPink>Constraint</#>
  <#Lavender>DTOs</#>
  --> solid: Import/Call
endlegend

@enduml
